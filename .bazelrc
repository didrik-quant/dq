# Bazel configuration for dq monorepo

# Enable bzlmod (default in Bazel 8+)
common --enable_bzlmod

# Java toolchain - use JDK 21
build --java_language_version=21
build --java_runtime_version=remotejdk_21
build --tool_java_language_version=21
build --tool_java_runtime_version=remotejdk_21

# Kotlin settings
build --@rules_kotlin//kotlin/settings:jvm_target=21

# Build optimizations
build --experimental_strict_action_env
build --incompatible_strict_action_env

# Test output settings
test --test_output=errors
test --test_verbose_timeout_warnings

# Caching
build --experimental_remote_cache_compression

# Error reporting
build --verbose_failures

# CI configuration
build:ci --color=yes
build:ci --curses=no
test:ci --test_output=all

# ktlint configuration
build --aspects=@rules_kotlin//kotlin:lint.bzl%ktlint_aspect
build --output_groups=+ktlint
