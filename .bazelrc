# Bazel configuration for dq monorepo

# Enable bzlmod (default in Bazel 8+)
common --enable_bzlmod

# Java toolchain - use JDK 21
build --java_language_version=21
build --java_runtime_version=remotejdk_21
build --tool_java_language_version=21
build --tool_java_runtime_version=remotejdk_21

# Build optimizations
build --incompatible_strict_action_env

# Test output settings
test --test_output=errors
test --test_verbose_timeout_warnings

# Caching
build --remote_cache_compression

# Error reporting
build --verbose_failures

# CI configuration
build:ci --color=yes
build:ci --curses=no
test:ci --test_output=all

# ktlint is configured via ktlint_test rules in BUILD files
# See //tools:ktlint for project-wide lint targets
