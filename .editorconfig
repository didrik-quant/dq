# EditorConfig for dq monorepo
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

# ktlint specific settings
ktlint_standard = enabled
ktlint_code_style = ktlint_official

[*.{yaml,yml}]
indent_size = 2

[*.{json,bzl}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[BUILD.bazel]
indent_size = 4

[MODULE.bazel]
indent_size = 4

[WORKSPACE]
indent_size = 4
